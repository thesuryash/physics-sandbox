# .gitignore for a Unity UPM package repository.
# This repo is a package (Runtime/, Editor/, Samples~/), not a full Unity project.
# NOTE: *.meta files are intentionally NOT ignored — Unity needs them for every asset.

# Leftover Unity cache/build folders (only appear if a Unity project references
# this repo in place; never part of the redistributable package).
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Pp]ackages/
/[Pp]roject[Ss]ettings/
/[Mm]emoryCaptures/
/[Ll]ogs.meta
/[Tt]emp.meta
/[Pp]ackages.meta
/package.json.meta
/*.md.meta

# Auto-generated IDE / solution files
.vs/
.idea/
.gradle/
.consulo/
ExportedObj/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.opendb
*.VC.db

# Packaged binaries — the package ships loose assets, not .unitypackage archives
*.unitypackage
*.unitypackage.meta

# Logs and crash reports
*.log
sysinfo.txt
mono_crash.*
crashlytics-build.properties

# OS files
.DS_Store
Thumbs.db

# TestProject~ is a tracked scaffold (used by CI to install/compile this
# package like a real user would), but its generated Unity cache/lock
# files are not.
/TestProject~/Library/
/TestProject~/Temp/
/TestProject~/Logs/
/TestProject~/UserSettings/
/TestProject~/obj/
/TestProject~/artifacts/
/TestProject~/Packages/packages-lock.json
/TestProject~/*.csproj
/TestProject~/*.sln
