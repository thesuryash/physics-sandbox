# .gitignore for a Unity UPM package repository.
# This repo is a package (Runtime/, Editor/, Samples~/), not a full Unity project.
# NOTE: *.meta files are intentionally NOT ignored — Unity needs them for every asset.

# Leftover Unity cache/build folders (only appear if a Unity project references
# this repo in place; never part of the redistributable package).
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/

# Auto-generated IDE / solution files
.vs/
.idea/
.gradle/
.consulo/
ExportedObj/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.opendb
*.VC.db

# Packaged binaries — the package ships loose assets, not .unitypackage archives
*.unitypackage
*.unitypackage.meta

# Logs and crash reports
*.log
sysinfo.txt
mono_crash.*
crashlytics-build.properties

# OS files
.DS_Store
Thumbs.db
